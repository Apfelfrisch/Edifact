{
    "name": "apfelfrisch/edifact",
    "description": "Parse, build, serialize and validate UN/EDIFACT messages",
    "license": "MIT",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "carthage-software/mago": "^1.47",
        "infection/infection": "^0.31",
        "phpunit/phpunit": "^12.4",
        "symfony/var-dumper": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "Apfelfrisch\\Edifact\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Apfelfrisch\\Edifact\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "fmt": "mago fmt",
        "lint": "mago lint",
        "analyze": "mago analyze",
        "check": [
            "@fmt --check",
            "@lint",
            "@analyze",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        },
        "allow-plugins": {
            "infection/extension-installer": true,
            "carthage-software/mago": true
        }
    }
}
